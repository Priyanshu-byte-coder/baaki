# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Only the tail stage needs any of this. The deterministic and algorithmic
# stages -- which close the large majority of every batch -- run fully offline,
# so a reconciliation run never depends on a network call being available.

# Key pool. The provider meters tokens per minute per (key, model) pair, so
# each extra key is a full extra budget rather than a shared one. Buys
# throughput only: not better answers, not a larger context window.
BAAKI_GROQ_API_KEYS=gsk_key_one,gsk_key_two

# Tail resolver. Handles the residue the earlier stages could not close.
BAAKI_TAIL_MODEL=openai/gpt-oss-120b

# Second model for the self-check pass. A different model means a separate
# TPM bucket as well as a second opinion.
BAAKI_CHECKER_MODEL=openai/gpt-oss-20b

# Free-tier limit is 8000 tokens/min per model. Raise on a paid key.
BAAKI_TPM_LIMIT=8000
BAAKI_MAX_RETRIES=4
BAAKI_MAX_CONCURRENCY=2
